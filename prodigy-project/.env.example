# Copy this file to `.env` and fill in real values there.
# NEVER commit a real .env with actual secrets.

# Obtained from Kaspi's existing Prodigy account/license. Do not commit a
# real key ever — ask the team who administers the Prodigy license.
PRODIGY_LICENSE=

# Point this at the SAME database Prodigy already uses (see prodigy.json ->
# db_settings), so MarkupSession lives alongside Prodigy's own tables
# instead of standing up new infrastructure. Example for sqlite:
#   PRODIGY_DB_URL=sqlite:///prodigy.db
# Example for postgresql:
#   PRODIGY_DB_URL=postgresql://user:password@host:5432/prodigy
PRODIGY_DB_URL=

# Optional: if the dev team decides MarkupSession should live in its own
# database instead of Prodigy's (see README.md, "open question"), point this
# at that separate database. If left empty, db/init_db.py falls back to a
# local sqlite file for local/demo use.
DASHBOARD_DB_URL=

# Port the read-only analytics dashboard (dashboard/app.py) listens on.
DASHBOARD_PORT=8001
